<Window x:Class="Arclike.Views.TabSwitcherOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:Arclike.Helpers"
        Title="Arclike Switcher"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        AutomationProperties.AutomationId="ArclikeSwitcher">

    <Window.Resources>
        <DataTemplate x:Key="CardTemplate">
            <helpers:AutomationBorder x:Name="CardBorder"
                    Width="{Binding CardWidth}" Height="{Binding CardHeight}"
                    CornerRadius="10"
                    Margin="6,0"
                    ClipToBounds="True"
                    BorderThickness="1"
                    BorderBrush="#26FFFFFF"
                    Background="Transparent"
                    MouseMove="Card_MouseMove"
                    AutomationProperties.AutomationId="SwitcherCard"
                    AutomationProperties.Name="{Binding Title}">
                <Grid>
                    <Image x:Name="ThumbnailImage"
                           Source="{Binding Thumbnail}"
                           Stretch="UniformToFill" />

                    <!-- Without a preview: a gradient with the favicon in the middle. -->
                    <Grid x:Name="Fallback" Visibility="Collapsed">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#99808080" Offset="0"/>
                                <GradientStop Color="#66808080" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Image Source="{Binding Favicon}" Width="36" Height="36" />
                    </Grid>

                    <Border VerticalAlignment="Top">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#CC000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <DockPanel Margin="6,5,6,10" LastChildFill="True">
                            <Image DockPanel.Dock="Left" Source="{Binding Favicon}" Width="12" Height="12" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleStyle}" />
                        </DockPanel>
                    </Border>
                </Grid>
            </helpers:AutomationBorder>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="CardBorder" Property="BorderThickness" Value="3"/>
                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                    <Setter TargetName="ThumbnailImage" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Fallback" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="RowPanel">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
        </ItemsPanelTemplate>
    </Window.Resources>

    <Border CornerRadius="20"
            Background="#E6181818"
            BorderBrush="#30FFFFFF"
            BorderThickness="0.5"
            Padding="10,16">
        <StackPanel VerticalAlignment="Center">
            <ItemsControl x:Name="TopRow" ItemTemplate="{StaticResource CardTemplate}" ItemsPanel="{StaticResource RowPanel}" />
            <ItemsControl x:Name="BottomRow" ItemTemplate="{StaticResource CardTemplate}" ItemsPanel="{StaticResource RowPanel}" Margin="0,12,0,0" />
        </StackPanel>
    </Border>
</Window>
