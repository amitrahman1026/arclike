<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the platform-neutral parts of the Windows app. They target plain net8.0 and link
       the source files, so they also run on macOS: dotnet test native-host-windows/Arclike.Tests -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Arclike\Models\SwitcherLayout.cs" Link="Linked\SwitcherLayout.cs" />
    <Compile Include="..\Arclike\Models\CommandBarItem.cs" Link="Linked\CommandBarItem.cs" />
    <Compile Include="..\Arclike\Models\ShortcutConfig.cs" Link="Linked\ShortcutConfig.cs" />
    <Compile Include="..\Arclike\Services\HostRegistry.cs" Link="Linked\HostRegistry.cs" />
    <Compile Include="..\Arclike\Services\ArcImport.cs" Link="Linked\ArcImport.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
