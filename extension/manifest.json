{
  "manifest_version": 3,
  "name": "Arclike",
  "short_name": "Arclike",
  "description": "Arc-style tab switching for Chrome: a Ctrl+Tab switcher of recent tabs and a Cmd+T / Cmd+L command bar. Needs the Arclike Mac app.",
  "version": "0.6.0",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "activeTab",
    "storage",
    "history",
    "bookmarks",
    "topSites",
    "search",
    "favicon",
    "sessions",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "mainsw.js"
  },
  "commands": {
    "alt_switch_fast": {
      "suggested_key": {
        "default": "Alt+W",
        "mac": "Alt+W"
      },
      "description": "Quick switch between last 2 tabs"
    },
    "alt_switch_slow_backward": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Cycle backward through tabs"
    },
    "alt_switch_slow_forward": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Cycle forward through tabs"
    }
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    },
    "default_popup": "popup.html"
  }
}
